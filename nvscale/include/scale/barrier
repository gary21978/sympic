/*
 * NVScale Compatibility Shim
 * --------------------------
 * This is NOT an official SmartLogic SCALE header.
 * It maps a subset of SCALE/MAPS/Aurora APIs to NVIDIA CUDA for local
 * compilation and functional bring-up.
 */
#pragma once

#include <cuda_runtime.h>
#include <stddef.h>
#include <string.h>
#include "scale.h"

namespace scale {
enum thread_scope {
  thread_scope_thread,
  thread_scope_block,
  thread_scope_device,
  thread_scope_system
};

enum barrier_type {
  sync_read_write,
  sync_read,
  sync_write,
  sync_none
};

enum async_contract_fulfillment {
  none,
  async
};

template <size_t Alignment>
struct aligned_size_t {
  __device__ __host__ explicit aligned_size_t(size_t size) : value(size) {}
  __device__ __host__ operator size_t() const { return value; }
  static constexpr size_t align = Alignment;
  size_t value;
};

struct dma_config {
  int granularity;
  int warp_size;
  int src_stride;
  int dst_stride;
  int rows;
  int cols;
};

struct __empty_completion {
  __device__ void operator()() noexcept {}
};

template <thread_scope Scope, class Completion = __empty_completion,
          bool NeedSwitch = true, barrier_type Type = sync_read_write,
          bool SyncMPU = true>
struct barrier {
  using arrival_token = unsigned;

  __device__ barrier() = default;
  __device__ explicit barrier(unsigned) {}
  __device__ barrier(unsigned, Completion completion) : completion_(completion) {}

  __device__ arrival_token arrive() { return 0; }
  __device__ void wait(arrival_token &&) { wait_impl(); }
  __device__ void arrive_and_wait() { wait_impl(); }

  Completion completion_;

private:
  __device__ void wait_impl() {
    if (Scope == thread_scope_block) {
      __syncthreads();
    } else if (SyncMPU) {
      __threadfence_block();
    }
  }
};
} // namespace scale

template <typename Barrier>
__device__ static inline void init(Barrier *, unsigned int) {}

template <typename Barrier, typename Completion>
__device__ static inline void init(Barrier *, unsigned int, Completion) {}

template <typename Size>
__device__ static inline size_t nvscale_copy_size(Size bytes) {
  return (size_t)bytes;
}

template <typename Group, typename Destination, typename Source, typename Size,
          typename Barrier>
__device__ static inline scale::async_contract_fulfillment memcpy_async(
    const Group &, Destination *dst, const Source *src, Size bytes, Barrier &,
    const scale::dma_config & = scale::dma_config{12, 15, 4096, 4096, 1, 4096},
    const scale::dma_config & = scale::dma_config{12, 15, 4096, 4096, 1, 4096}) {
  memcpy((void *)dst, (const void *)src, nvscale_copy_size(bytes));
  return scale::async;
}

template <typename Destination, typename Source, typename Size,
          typename Barrier>
__device__ static inline scale::async_contract_fulfillment memcpy_async(
    Destination *dst, const Source *src, Size bytes, Barrier &barrier,
    const scale::dma_config &dst_config =
        scale::dma_config{12, 15, 4096, 4096, 1, 4096},
    const scale::dma_config &src_config =
        scale::dma_config{12, 15, 4096, 4096, 1, 4096}) {
  struct nvscale_single_thread_group {};
  return memcpy_async(nvscale_single_thread_group{}, dst, src, bytes, barrier,
                      dst_config, src_config);
}
